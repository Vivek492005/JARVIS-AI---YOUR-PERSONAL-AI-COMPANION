# ============================================================
# JARVIS Environment Configuration Template
# ------------------------------------------------------------
# 1. Copy this file and rename the copy to ".env"
#    (PowerShell:  Copy-Item .env.example .env)
# 2. Fill in your own API keys below.
# 3. Never commit your real ".env" file — it's already
#    covered by .gitignore.
# ============================================================

# ---- Primary LLM Brain: Hugging Face (Qwen 2.5 72B Instruct) ----
# Get a free token: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_your_token_here
HUGGINGFACE_BASE_URL=https://router.huggingface.co/v1
HUGGINGFACE_MODEL=Qwen/Qwen2.5-72B-Instruct

# ---- Secondary Fallback LLM: DeepSeek ----
# Get a key: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk_your_deepseek_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ---- Primary Voice Engine: Rumik AI Silk TTS ----
# Get a key: https://rumik.ai/
RUMIK_API_KEY=your_rumik_key_here
RUMIK_API_URL=https://silk-api.rumik.ai/v1/tts
RUMIK_MODEL=muga
